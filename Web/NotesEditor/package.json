    "@tiptap/extension-task-item": "3.29.2",
    "@tiptap/extension-task-list": "3.29.2",
    "@tiptap/markdown": "3.29.2",
    "@tiptap/pm": "3.29.2",
    "@tiptap/starter-kit": "3.29.2",
    "diff": "8.0.4",
    "dompurify": "3.4.12",
    "highlight.js": "11.11.1",
    "katex": "0.18.1",
